#!/usr/bin/env bash
# The checks every change must pass, run on this machine by `local-ci` (claude-toolkit)
# in place of GitHub Actions. Run it directly to check without posting a status.
# Builds the deck from its source, so a broken source file, build script or missing
# audio clip fails here. The built .apkg is git-ignored.
set -euo pipefail
cd "$(dirname "$0")"
scripts/check-release-links.sh
# Decks with audio name their clips with the Psittacus submodule's code.
[ -f .gitmodules ] && git submodule update --init -q
uv run --no-project -q -p 3.13 --with genanki==0.13.1 python build.py
